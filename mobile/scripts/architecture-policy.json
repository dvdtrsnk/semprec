        "origin.action.retake",
        "origin.action.unlink",
        "origin.broken.byAgent",
        "origin.broken.byUser",
        "origin.broken.title",
        "origin.derived.text",
        "origin.derived.title",
        "origin.inherited.text",
        "origin.inherited.title",
        "origin.source.areas",
        "origin.source.companies",
        "origin.source.events",
        "origin.source.files",
        "origin.source.healthRecords",
        "origin.source.other",
        "origin.source.people",
        "origin.source.projects",
        "origin.source.tasks",
        "origin.source.threads",
        "origin.source.transcripts",
        "origin.source.unknown",
        "page.cancel",
        "page.edit",
        "page.editor.title",
        "page.retry",
        "page.save",
        "picker.cancel",
        "picker.empty",
        "picker.search",
        "preview.done",
        "preview.unsupported",
        "project.agent",
        "project.deadline",
        "project.deadline.none",
        "project.notes",
