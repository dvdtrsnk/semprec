    "appleOnly": ["LoginViewModel", "SessionViewModel", "TasksViewModel", "ItemDetailsViewModel", "OverviewViewModel", "SearchViewModel"],
    "androidOnly": ["HomeViewModel", "DetailViewModel", "SettingsViewModel"]
  },
