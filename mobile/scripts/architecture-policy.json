        "project.pinned.footer",
        "project.settings",
        "project.settings.done",
        "project.tasks",
        "project.tasks.all",
        "relation.add",
        "relation.remove",
        "section.noValue"
      ]
    },
    {
      "android": ":android:core:ui",
      "apple": "DesignSystem",
      "keys": ["state.loading", "state.retry"]
    },
    {
      "android": ":android:feature:home",
      "apple": "HomeFeature",
      "keys": [
        "home.title",
        "home.item.title",
        "home.empty",
        "detail.title",
        "detail.description",
        "detail.notFound",
        "failure.unavailable",
        "failure.invalidData",
        "failure.unauthorized",
        "failure.notFound",
        "failure.rejected",
        "failure.unexpected"
      ],
      "androidOnly": ["detail.back"]
    },
    {
      "android": ":android:feature:settings",
      "apple": "SettingsFeature",
      "keys": ["settings.title", "settings.row.about", "about.title", "about.description", "about.version", "about.done"]
    }
  ]
}
