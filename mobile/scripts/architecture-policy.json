      "SleepFeatureTests": { "project": "Modules/Features/Sleep", "sources": "Tests", "allowed": ["SleepFeature", "CoreKit"] },
      "Semprec": {
        "project": "Projects/App",
        "sources": "Sources",
        "allowed": ["AuthFeature", "CoreKit", "Dependencies", "DesignSystem", "HomeFeature", "SettingsFeature", "CalendarFeature", "JournalFeature", "SleepFeature", "NavigatorUI"]
      },
      "SemprecTests": { "project": "Projects/App", "sources": "Tests", "allowed": ["Semprec", "CoreKit", "NavigatorUI"] },
      "SemprecUITests": { "project": "Projects/App", "sources": "UITests", "allowed": [], "appUnderTest": "Semprec" }
    }
