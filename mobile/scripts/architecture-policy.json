      "DesignSystemTests": { "project": "Modules/Core/DesignSystem", "sources": "Tests", "allowed": ["DesignSystem"] },
      "OverviewFeature": { "project": "Modules/Features/Overview", "sources": "Sources", "allowed": ["CoreKit", "DesignSystem"] },
      "OverviewFeatureTests": { "project": "Modules/Features/Overview", "sources": "Tests", "allowed": ["OverviewFeature", "CoreKit"] },
      "TasksFeature": { "project": "Modules/Features/Tasks", "sources": "Sources", "allowed": ["CoreKit", "DesignSystem"] },
      "TasksFeatureTests": { "project": "Modules/Features/Tasks", "sources": "Tests", "allowed": ["TasksFeature", "CoreKit"] },
      "Semprec": {
        "project": "Projects/App",
        "sources": "Sources",
        "allowed": ["AuthFeature", "CoreKit", "Dependencies", "DesignSystem", "OverviewFeature", "TasksFeature", "NavigatorUI"]
      },
      "SemprecTests": { "project": "Projects/App", "sources": "Tests", "allowed": ["Semprec", "CoreKit", "OverviewFeature", "NavigatorUI"] },
      "SemprecUITests": { "project": "Projects/App", "sources": "UITests", "allowed": [], "appUnderTest": "Semprec" }
    }
  },
  "viewModels": {
