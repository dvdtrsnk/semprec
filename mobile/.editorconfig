root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,md}]
indent_size = 2

[*.{ts,tsx,js,mjs,cjs,css}]
indent_size = 2

# Kotlin: detekt-formatting (ktlint) and config/detekt/detekt.yml use the same limit. Swift: SwiftLint's
# line_length warning threshold.
[*.{kt,kts,swift}]
max_line_length = 120

[*.bat]
end_of_line = crlf
