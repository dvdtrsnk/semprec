    "collection.add.book.hint" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí název. Autora, rok, obálku a hodnocení zdroje dohledá Semp – když se mu to nepovede, zkusí to znovu v noci."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The title is enough. Semp looks up the author, year, cover and source rating; when it cannot find them, it tries again at night."
          }
        }
      }
    },
