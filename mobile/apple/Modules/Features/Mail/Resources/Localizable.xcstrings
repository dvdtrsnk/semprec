    "mail.tasks.footer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlákno bere firmu od odesílatele a projekt od firmy. Přílohy a úkoly z vlákna převezmou projekt vlákna a lidi z konverzace – dokud je u nich nezměníš ty nebo Semp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The thread takes the company from the sender and the project from the company. Files and tasks from the thread take the thread's project and the people of the conversation until you or Semp change them."
          }
        }
      }
    },
