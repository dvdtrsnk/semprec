    "details.repeat.hint" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesplněný úkol se o půlnoci označí v daném dni jako nesplněný a přesune se na další den. Opakovaný úkol se jen označí jako nesplněný, když se další den opakuje – pokračuje se dalším opakováním."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A task not done is marked as not done on its day at midnight and moves to the next day. A repeating task is only marked as not done when it repeats the next day, and goes on with the next repeat."
          }
        }
      }
    },
