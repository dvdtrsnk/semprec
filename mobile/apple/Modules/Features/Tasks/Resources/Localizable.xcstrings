    "details.delete.impactEvent" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Událost půjde 30 dní obnovit z Nedávno smazaných. Úkoly z akčních bodů, nahrávka a přílohy zůstanou a projekt, firmu a lidi, které měly z události, si ponechají jako vlastní."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The event can be restored for 30 days from Recently deleted. Tasks made from its action items, its recording and its attachments stay, and keep the project, company and people they took from the event as their own."
          }
        }
      }
    },
    "details.delete.impactFile" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příloha zůstane ve sbírce Soubory a projekt, který měla z úkolu, si ponechá jako vlastní."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attachment stays in Files and keeps the project it took from the task as its own."
          }
        }
      }
    },
    "details.delete.impactFiles" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přílohy (%lld) zůstanou ve sbírce Soubory a projekt, který měly z úkolu, si ponechají jako vlastní."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attachments (%lld) stay in Files and keep the project they took from the task as their own."
          }
        }
      }
    },
