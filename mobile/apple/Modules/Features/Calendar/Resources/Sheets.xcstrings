      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narozeniny se berou z lidí ve sbírce Lidé, upravují se tam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birthdays come from the people in the People collection and are edited there."
