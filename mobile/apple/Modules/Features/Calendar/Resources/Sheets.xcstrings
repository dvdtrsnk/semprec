    "calendars.detail.hint.default" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění se řídí nastavením u jednotlivých událostí. Vypnutím ztišíš celý kalendář."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications follow the settings of each event. Turning them off silences the whole calendar."
          }
        }
      }
    },
