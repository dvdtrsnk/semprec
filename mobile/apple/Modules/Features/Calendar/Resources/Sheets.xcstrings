    "calendars.delete.cancellations" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smažou se i události v kalendáři (%1$lld) a pozvaní lidé (%2$lld) dostanou zrušení (%3$lld)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its events (%1$lld) are deleted too, and the invited people (%2$lld) get cancellations (%3$lld)."
          }
        }
      }
    },
