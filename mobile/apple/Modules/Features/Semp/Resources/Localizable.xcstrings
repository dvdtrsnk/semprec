    "semp.subject.note" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle vlákno slouží jen k úpravě téhle položky. Vidím celé zachycení i to, co jsem z něj navrhl – napiš, co mám udělat jinak, a změnu propíšu rovnou do Inboxu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This thread only edits this item. I see the whole capture and what I proposed from it – tell me what to do differently and I will write the change straight into the Inbox."
          }
        }
      }
