# This file is for local development only — run this service alone against a local database. In
# production every value here (and more: VAPID/APNs/restic/healthchecks/...) instead comes from
# the single `/opt/semprec/shared/.env` (issue #175, see deploy/shared/.env.example), loaded via
# systemd `EnvironmentFile=`. `SEMPREC_API_DATABASE_URL` there is this same value under the name
# that avoids colliding with the `semprec_side`-role processes reading the same shared file.

# DATABASE_URL: Postgres connection string. Must authenticate as the `semprec_data` role
# (issue #243) — semprec-api is the one service that hosts the generic choke-point
# (createChokePoint()), and is the only service allowed to hold this connection string. See
# docs/operations/database-roles.md.
DATABASE_URL=postgres://semprec_data:changeme@localhost:5432/semprec

# SETUP_TOKEN: one-time bootstrap secret for POST /api/setup (issue #233).
SETUP_TOKEN=

# PORT: this process's own listen port.
PORT=3001

# APP_BASE_URL / SMTP_*: optional — back password-reset emails (issue #142). The service boots
# without them; only the password-reset request route fails until they're configured.
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_ADDRESS=
SMTP_USER=
SMTP_PASSWORD=

# AI_GATEWAY_PORT / AI_GATEWAY_INTERNAL_TOKEN: issue #215's bootstrap token, shared with
# semprec-ai-gateway (see services/semprec-ai-gateway/.env.example) — any process that composes
# an AiGatewayClientPort against http://127.0.0.1:${AI_GATEWAY_PORT}/internal/complete uses these.
AI_GATEWAY_PORT=3002
AI_GATEWAY_INTERNAL_TOKEN=
