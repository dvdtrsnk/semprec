# Local development only. The transcription worker hosts its narrow in-process choke-point
# writer, so it authenticates as `semprec_data`; production supplies SEMPREC_API_DATABASE_URL.
DATABASE_URL=postgres://semprec_data:changeme@localhost:5432/semprec

# FILES_STORAGE_DIR: local-filesystem root for blob bytes (issue #246). Step 1 (`prepare`) reads
# a source recording's blob and writes the normalized audio's blob back into this same directory,
# so it must point at the same path semprec-api's own FILES_STORAGE_DIR uses.
FILES_STORAGE_DIR=/tmp/semprec-files

# AI_GATEWAY_PORT / AI_GATEWAY_INTERNAL_TOKEN: how steps 2, 3 and 5 reach semprec-ai-gateway over
# loopback (diarize, transcribe, and the transcript summary's complete call); the token must match
# the gateway's own AI_GATEWAY_INTERNAL_TOKEN.
AI_GATEWAY_PORT=3002
AI_GATEWAY_INTERNAL_TOKEN=changeme
