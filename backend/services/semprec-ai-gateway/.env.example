# DATABASE_URL: Postgres connection string, same database as semprec-api. Must authenticate as
# the `semprec_side` role (issue #243) — this service only ever writes `ai_gateway_calls`, a
# module side table, and never the choke-point tables, so it must never use the choke-point's
# own connection string. See docs/operations/database-roles.md.
DATABASE_URL=postgres://semprec_side:changeme@localhost:5432/semprec

# AI_GATEWAY_PORT: this process's own listen port. semprec-ai-gateway-client reaches it at
# http://127.0.0.1:${AI_GATEWAY_PORT}/internal/complete.
AI_GATEWAY_PORT=3002

# AI_GATEWAY_INTERNAL_TOKEN: shared bootstrap secret (issue #215) — the gateway rejects any
# POST /internal/complete whose Authorization: Bearer token doesn't match this value. Must be
# identical to the value configured on every process that calls the gateway (see
# services/semprec-api/.env.example).
AI_GATEWAY_INTERNAL_TOKEN=

# AI_GATEWAY_STRUCTURED_PROVIDER / AI_GATEWAY_STRUCTURED_MODEL: the provider+model
# POST /internal/complete uses. Startup fails if either is missing, or if the provider id isn't
# registered, or if it doesn't advertise native JSON-Schema structured output. There is
# deliberately no default.
AI_GATEWAY_STRUCTURED_PROVIDER=anthropic
AI_GATEWAY_STRUCTURED_MODEL=

# ANTHROPIC_API_KEY: required when AI_GATEWAY_STRUCTURED_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK / AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK:
# USD per million tokens for the configured model, used to price each ai_gateway_calls row.
# Read from configuration rather than a hardcoded table since rate cards change over time.
AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK=
AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK=
