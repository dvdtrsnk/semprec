# Local development only. The agents worker hosts the choke point in-process for its agent runs'
# tools, so it authenticates as `semprec_data`; production supplies SEMPREC_API_DATABASE_URL.
# DATABASE_URL: the in-process choke point needs write access to the choke-point tables.
DATABASE_URL=postgres://semprec_data:changeme@localhost:5432/semprec

# AI_GATEWAY_BASE_URL: where agent model calls go (semprec-ai-gateway).
AI_GATEWAY_BASE_URL=http://localhost:3002

# AI_GATEWAY_INTERNAL_TOKEN: bearer token; must match the gateway's own AI_GATEWAY_INTERNAL_TOKEN.
AI_GATEWAY_INTERNAL_TOKEN=changeme

# AGENT_MODEL: the model id every agent session requests through the gateway.
AGENT_MODEL=changeme
