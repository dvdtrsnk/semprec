{
  "name": "@semprec/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testSupport": "./src/testSupport/testDb.ts",
    "./testSupport/mcpContractServers": "./src/testSupport/mcpContractServers.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/migrations && cp -r src/seed/i18n dist/seed/i18n && cp -r src/chokePoint/i18n dist/chokePoint/i18n && cp -r src/views/i18n dist/views/i18n && cp -r src/inbox/i18n dist/inbox/i18n && cp -r src/library/i18n dist/library/i18n && cp -r src/mail/i18n dist/mail/i18n",
    "check-migration-numbering": "node scripts/check-migration-numbering.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.2.0",
    "@semprec/credentials": "workspace:*",
    "@semprec/module-registry": "workspace:*",
    "@semprec/queue": "workspace:*",
    "imapflow": "^1.7.6",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.17",
    "mammoth": "^1.12.2",
    "nodemailer": "^9.0.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "yjs": "^13.6.32",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "vitest": "^4.1.11"
  }
}
