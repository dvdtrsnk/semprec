[Unit]
Description=Semprec mail sync worker for %i
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=semprec
Group=semprec
WorkingDirectory=/opt/semprec/current/backend
EnvironmentFile=/opt/semprec/shared/.env
ExecStart=/usr/bin/env node /opt/semprec/current/backend/services/semprec-mailsync/dist/serve.js %i
