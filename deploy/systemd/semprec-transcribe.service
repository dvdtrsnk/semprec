[Unit]
Description=Semprec transcription worker
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=15min
StartLimitBurst=180
OnFailure=semprec-failping@%n.service

[Service]
Type=simple
User=semprec
Group=semprec
WorkingDirectory=/opt/semprec/current/backend
EnvironmentFile=/opt/semprec/shared/.env
EnvironmentFile=/opt/semprec/current/release.env
SyslogIdentifier=semprec-transcribe
ExecStart=/usr/bin/env node /opt/semprec/current/backend/services/semprec-transcribe/dist/serve.js
Restart=on-failure
RestartSec=5s
# Worst-case one ASR chunk: ffmpeg extraction (5min cap) + gateway call (10min
# cap) + checkpoint write; the task exits at its next checkpoint once
# runner.stop() has begun.
TimeoutStopSec=960

[Install]
WantedBy=multi-user.target
