[Unit]
Description=Alldots monthly restore test
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Root, like alldots-backup.service: the test drives Docker and restic directly.
EnvironmentFile=/opt/alldots/shared/env/side-role.env
EnvironmentFile=/opt/alldots/shared/env/settings.env
EnvironmentFile=/opt/alldots/shared/env/backup.env
SyslogIdentifier=alldots-restore-test
TimeoutStartSec=6h
ExecStart=/bin/bash /opt/alldots/shared/bin/alldots-restore-test.sh
