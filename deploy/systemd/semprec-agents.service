[Unit]
Description=Semprec agents queue worker
Wants=network-online.target semprec-mcp-launch.socket
After=network-online.target docker.service semprec-mcp-launch.socket
StartLimitIntervalSec=15min
StartLimitBurst=180
OnFailure=semprec-failping@%n.service

[Service]
Type=simple
User=semprec
Group=semprec
WorkingDirectory=/opt/semprec/current/backend
EnvironmentFile=/opt/semprec/shared/env/data-role.env
EnvironmentFile=/opt/semprec/shared/env/master-key.env
EnvironmentFile=/opt/semprec/shared/env/gateway-token.env
EnvironmentFile=/opt/semprec/shared/env/agents.env
EnvironmentFile=/opt/semprec/shared/env/settings.env
EnvironmentFile=/opt/semprec/current/release.env
Environment=SEMPREC_MCP_LAUNCH_SOCKET=/run/semprec-mcp-launch.sock
SyslogIdentifier=semprec-agents
ExecStart=/usr/bin/env node /opt/semprec/current/backend/services/semprec-agents/dist/serve.js
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
