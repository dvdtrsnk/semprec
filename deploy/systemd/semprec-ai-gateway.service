[Unit]
Description=Semprec AI gateway
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=15min
StartLimitBurst=180
OnFailure=semprec-failping@%n.service

[Service]
Type=simple
User=semprec
Group=semprec
# Process containment (issue #1071), see deploy/README.md "Service sandboxing".
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Not set: MemoryDenyWriteExecute=, V8 JIT needs writable-executable pages.
# Not set: ProcSubset=pid, it hides /proc/cpuinfo and /proc/meminfo that Node os reads.
# Not set: PrivateUsers=, it remaps the uid/gid namespace that ownership checks depend on.
WorkingDirectory=/opt/semprec/current/backend
EnvironmentFile=/opt/semprec/shared/env/side-role.env
EnvironmentFile=/opt/semprec/shared/env/gateway-token.env
EnvironmentFile=/opt/semprec/shared/env/ai-gateway.env
EnvironmentFile=/opt/semprec/current/release.env
SyslogIdentifier=semprec-ai-gateway
ExecStart=/usr/bin/env node /opt/semprec/current/backend/services/semprec-ai-gateway/dist/serve.js
Restart=on-failure
RestartSec=5s
# 600 s drain (SHUTDOWN_DRAIN_TIMEOUT_MS) + 5 s pool end (POOL_END_TIMEOUT_MS) + margin.
TimeoutStopSec=660

[Install]
WantedBy=multi-user.target
