# Secret group `api`: semprec-api's own settings and secrets: setup token, listener, push, OAuth clients, public URL and outbound mail.
# Loaded by: semprec-api.service.
#
# Ownership and mode are load-bearing: `root:root 0600`. systemd reads EnvironmentFile= as root
# before dropping privileges. provision.sh installs this template to
# /opt/semprec/shared/env/api.env only when that file does not exist, so an operator's values are
# never overwritten by a rerun, and it never prints a value. A key belongs to exactly one group
# (docs/adr/2026-10-03-per-service-secret-groups.md); this file is excluded from restic backups.
#
# `apns-key.p8` sits next to the group directory at `/opt/semprec/shared/apns-key.p8`,
# `root:semprec 0640`: the `semprec` service user reads it directly by path. Apple issues APNs auth
# keys as a `.p8` file, and a multi-line PEM has no safe representation as one `KEY=VALUE` line in
# an `EnvironmentFile=`, so it is distributed as its own file.

# SETUP_TOKEN: one-time bootstrap secret for POST /api/setup on semprec-api. Generate with:
# openssl rand -hex 32
SETUP_TOKEN=

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT: generate the key pair with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a mailto: or https: URL identifying this
# deployment's operator, per the Web Push protocol.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# APNS_TEAM_ID / APNS_KEY_ID / APNS_TOPIC: from the Apple Developer account's APNs auth key and
# the app's bundle id. APNS_PRIVATE_KEY_PATH points at the `.p8` file distributed alongside this
# one — see the header note.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=/opt/semprec/shared/apns-key.p8
APNS_TOPIC=

# GMAIL_OAUTH_CLIENT_ID / GMAIL_OAUTH_CLIENT_SECRET: Google Cloud OAuth client for Gmail API mail
# sync (mailSyncJob.ts's "gmail_api" mode). Consumed by semprec-api's mail sync jobs once built.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# MS_GRAPH_OAUTH_CLIENT_ID / MS_GRAPH_OAUTH_CLIENT_SECRET: Microsoft Entra app registration for
# Graph API mail sync (mailSyncJob.ts's "graph_api" mode). Consumed by semprec-api's mail sync jobs once
# built.
MS_GRAPH_OAUTH_CLIENT_ID=
MS_GRAPH_OAUTH_CLIENT_SECRET=

# PORT: the port semprec-api listens on. Must match deploy/Caddyfile's
# `reverse_proxy 127.0.0.1:8080` — the same way SEMPREC_DOMAIN (monitor.env) is also what
# provision.sh hands to Caddy through /etc/caddy/semprec.env.
PORT=8080

# TRUST_PROXY: semprec-api listens on loopback behind Caddy on the same host (deploy/Caddyfile),
# so every request's socket peer is 127.0.0.1. TRUST_PROXY=1 makes it read the last
# X-Forwarded-For hop (the one Caddy appends) as the client address for login throttling.
# Must be 1 in every deployment provisioned from deploy/; any other value means the header is ignored.
TRUST_PROXY=1

# APP_BASE_URL: read only by semprec-api. The public origin every emailed link (password reset,
# invitations) is built against. Must be https://<SEMPREC_DOMAIN> with no path. An absent value
# means http://localhost:3000; an empty one breaks every link.
APP_BASE_URL=

# SMTP_HOST: read only by semprec-api. The outbound mail relay; it must be reachable from this host.
# Mail is sent only when both SMTP_HOST and SMTP_FROM_ADDRESS are set; otherwise password-reset
# requests still answer 200 but nothing is sent.
SMTP_HOST=

# SMTP_PORT: read only by semprec-api. The relay's port. Non-empty on purpose: an empty value
# fails startup once SMTP is configured.
SMTP_PORT=587

# SMTP_SECURE: read only by semprec-api. true means implicit TLS (port 465); any other value
# means a plain connection upgraded with STARTTLS where the relay offers it.
SMTP_SECURE=false

# SMTP_FROM_ADDRESS: read only by semprec-api. The sender address of every outbound mail. Needed
# together with SMTP_HOST to send mail at all.
SMTP_FROM_ADDRESS=

# SMTP_USER: read only by semprec-api. The relay login; credentials are sent only when it is set.
SMTP_USER=

# SMTP_PASSWORD: read only by semprec-api. A secret. Sent only when SMTP_USER is set.
SMTP_PASSWORD=
