# Secret group `backup`: The off-site restic repository and its credentials, plus the restore test's monitor.
# Loaded by: semprec-backup.service, semprec-restore-test.service.
#
# Ownership and mode are load-bearing: `root:root 0600`. systemd reads EnvironmentFile= as root
# before dropping privileges. provision.sh installs this template to
# /opt/semprec/shared/env/backup.env only when that file does not exist, so an operator's values are
# never overwritten by a rerun, and it never prints a value. A key belongs to exactly one group
# (docs/adr/2026-10-03-per-service-secret-groups.md); this file is excluded from restic backups.

# RESTIC_REPOSITORY / RESTIC_PASSWORD: the off-site S3-compatible restic repository and its
# encryption password. RESTIC_PASSWORD is never the same value as CREDENTIALS_MASTER_KEY — a
# leaked backup password must not also unlock external_credentials, and vice versa.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: credentials for the backup-only S3-compatible
# repository. These must grant access only to the restic repository, not to MinIO or any
# application data store. The endpoint and bucket belong in RESTIC_REPOSITORY (for example,
# s3:https://s3.example.invalid/semprec-backups), so no provider selection is committed here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# HEALTHCHECKS_RESTORE_PING_URL: the monthly restore test's own monitor (issue #178), separate
# from the dead-man check (monitor.env). Pinged only after every restore assertion passed; a failed run
# pings its /fail endpoint instead.
HEALTHCHECKS_RESTORE_PING_URL=
