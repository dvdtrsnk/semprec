# Secret group `monitor`: The public domain and the dead-man monitor ping.
# Loaded by: semprec-dead-man.service, semprec-failping@.service.
#
# Ownership and mode are load-bearing: `root:root 0600`. systemd reads EnvironmentFile= as root
# before dropping privileges. provision.sh installs this template to
# /opt/semprec/shared/env/monitor.env only when that file does not exist, so an operator's values are
# never overwritten by a rerun, and it never prints a value. A key belongs to exactly one group
# (docs/adr/2026-10-03-per-service-secret-groups.md); this file is excluded from restic backups.

# SEMPREC_DOMAIN: the public Caddy domain, without a URL scheme. The dead-man timer probes
# https://$SEMPREC_DOMAIN/healthz before it sends the monitor success ping.
SEMPREC_DOMAIN=

# HEALTHCHECKS_PING_URL: pinged only after the five-minute dead-man timer's own public
# GET /healthz succeeds — this URL never substitutes for that check.
HEALTHCHECKS_PING_URL=
