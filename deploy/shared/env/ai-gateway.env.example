# Secret group `ai-gateway`: Provider credentials, models and price cards. Only the gateway holds them.
# Loaded by: semprec-ai-gateway.service.
#
# Ownership and mode are load-bearing: `root:root 0600`. systemd reads EnvironmentFile= as root
# before dropping privileges. provision.sh installs this template to
# /opt/semprec/shared/env/ai-gateway.env only when that file does not exist, so an operator's values are
# never overwritten by a rerun, and it never prints a value. A key belongs to exactly one group
# (docs/adr/2026-10-03-per-service-secret-groups.md); this file is excluded from restic backups.

# AI_GATEWAY_STRUCTURED_PROVIDER / AI_GATEWAY_STRUCTURED_MODEL: the provider+model
# POST /internal/complete uses. No default — startup fails without both.
AI_GATEWAY_STRUCTURED_PROVIDER=anthropic
AI_GATEWAY_STRUCTURED_MODEL=

# ANTHROPIC_API_KEY: required when AI_GATEWAY_STRUCTURED_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK / AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK: USD
# per million tokens for the configured model, read from configuration since rate cards change.
AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK=
AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK=

# PYANNOTEAI_API_KEY / DEEPINFRA_API_KEY: vendor credentials for POST /internal/diarize (pyannoteAI)
# and POST /internal/transcribe (DeepInfra Whisper large-v3). Read only inside semprec-ai-gateway's
# own environment, per docs/adr/2026-09-10-ai-gateway-monopoly-on-provider-calls.md.
PYANNOTEAI_API_KEY=
DEEPINFRA_API_KEY=

# AI_GATEWAY_PYANNOTE_PRICE_PER_AUDIO_HOUR / AI_GATEWAY_DEEPINFRA_PRICE_PER_AUDIO_HOUR: USD per
# hour of audio for each provider's current rate card, read from configuration for the same reason
# as the structured-completion prices.
AI_GATEWAY_PYANNOTE_PRICE_PER_AUDIO_HOUR=
AI_GATEWAY_DEEPINFRA_PRICE_PER_AUDIO_HOUR=

# OPENAI_API_KEY / AI_GATEWAY_OPENAI_STT_PRICE_PER_AUDIO_HOUR: credential and USD per hour of audio
# for the streaming speech-to-text route (GET /internal/stt/stream, WebSocket; OpenAI
# gpt-4o-transcribe), per docs/adr/2026-10-28-live-voice-chains-speech-to-text-agent-turn-and-text-to-speech.md.
# AI_GATEWAY_STT_CHUNK_SECONDS is optional (default 30): the seconds of audio one reserved
# ai_gateway_calls row covers.
OPENAI_API_KEY=
AI_GATEWAY_OPENAI_STT_PRICE_PER_AUDIO_HOUR=

# AI_GATEWAY_OPENAI_TTS_PRICE_PER_AUDIO_HOUR: USD per hour of synthesized audio for the streaming
# text-to-speech route (POST /internal/tts/stream; OpenAI gpt-4o-mini-tts, same OPENAI_API_KEY),
# per the same ADR. A request is reserved at this price for its estimated length and settled at
# the audio actually produced.
AI_GATEWAY_OPENAI_TTS_PRICE_PER_AUDIO_HOUR=

# AI_GLOBAL_DAILY_CAP_USD / AI_GLOBAL_MONTHLY_CAP_USD: REQUIRED operator-wide safety caps in USD
# over all tenants' spend (UTC day and month), checked next to each tenant's own caps. Each must
# be a positive number. A deploy without them leaves the gateway unable to start.
AI_GLOBAL_DAILY_CAP_USD=
AI_GLOBAL_MONTHLY_CAP_USD=
