# Secret group `agents`: semprec-agents' own settings.
# Loaded by: semprec-agents.service.
#
# Ownership and mode are load-bearing: `root:root 0600`. systemd reads EnvironmentFile= as root
# before dropping privileges. provision.sh installs this template to
# /opt/semprec/shared/env/agents.env only when that file does not exist, so an operator's values are
# never overwritten by a rerun, and it never prints a value. A key belongs to exactly one group
# (docs/adr/2026-10-03-per-service-secret-groups.md); this file is excluded from restic backups.

# AI_GATEWAY_BASE_URL: where semprec-agents sends every agent model call, as pi's `pi-messages`
# protocol (POST <AI_GATEWAY_BASE_URL>/messages, Bearer AI_GATEWAY_INTERNAL_TOKEN). Read only by
# semprec-agents; startup fails without it. Default value: http://127.0.0.1:3002/internal/pi
AI_GATEWAY_BASE_URL=

# AGENT_MODEL: the model id semprec-agents requests from the gateway for every agent session.
# Read only by semprec-agents; startup fails without it.
AGENT_MODEL=
