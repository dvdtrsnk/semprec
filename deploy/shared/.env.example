# Issue #175: values-free template for the one production secrets file, `/opt/semprec/shared/.env`.
# Provisioning (`provision.sh`, #244) copies this file to that path only when no `.env` already
# exists there, so an operator's already-configured values are never overwritten by a rerun.
#
# Ownership and mode are load-bearing, not a suggestion: `root:root 0600`. Every systemd unit
# (#176) loads this exact file via `EnvironmentFile=/opt/semprec/shared/.env`, and
# `deploy/docker-compose.yml`'s `postgres`/`minio` services already load it via `env_file:`
# (#174) — both mechanisms read it as the process's own user (systemd) or as whatever reads the
# compose file (root, typically), never as an unprivileged git checkout. This file itself is
# never deployed by a release: `deploy.sh` (#190) only ever writes into `releases/`, never into
# `shared/`, so a release rollback or redeploy can't touch it, and it is excluded from restic
# backups (#177) — losing it is recovered by re-provisioning secrets, not by restoring a backup
# that would otherwise carry the master key off-site next to the data it decrypts.
#
# `apns-key.p8` sits next to this file at `/opt/semprec/shared/apns-key.p8`, same `root:root 0600`
# ownership, same backup exclusion — Apple issues APNs auth keys as a `.p8` file, and a multi-line
# PEM has no safe representation as one `KEY=VALUE` line in either an `EnvironmentFile=` or a
# Docker `env_file:`, so it is distributed as its own file instead of inlined here.
#
# `external_credentials` (IMAP/OAuth/MCP secrets a user connects, `packages/credentials` +
# `packages/data/src/credentials/externalCredentialsStore.ts`) are never provisioned here: they
# are captured through the app, encrypted at rest under CREDENTIALS_MASTER_KEY below, and stored
# in their own table — this file only ever holds the deployment's own bootstrap secrets.

# ---- Master key (issue #40) ----

# CREDENTIALS_MASTER_KEY: base64-encoded 32-byte XSalsa20-Poly1305 key (see
# packages/credentials/src/index.ts's resolveMasterKeyFromEnv) that decrypts every row in
# `external_credentials`. Generate with: openssl rand -base64 32
# Rotation would add CREDENTIALS_MASTER_KEY_V2 etc. alongside this one — out of scope here (no
# rotation automation), but the naming is already versioned so a future issue can add it without
# touching this one.
CREDENTIALS_MASTER_KEY=

# ---- Setup (issue #233) ----

# SETUP_TOKEN: one-time bootstrap secret for POST /api/setup on semprec-api. Generate with:
# openssl rand -hex 32
SETUP_TOKEN=

# ---- Distinct Postgres + MinIO values ----

# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB: the deploy/docker-compose.yml `postgres`
# container's own init-time superuser and database — used once, by the operator, to connect and
# create the two least-privilege roles below (docs/operations/database-roles.md). No application
# process ever authenticates as this user.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=semprec

# SEMPREC_DATA_DB_PASSWORD / SEMPREC_SIDE_DB_PASSWORD: distinct passwords the operator sets with
# `ALTER ROLE semprec_data WITH PASSWORD '...'` / `ALTER ROLE semprec_side WITH PASSWORD '...'`
# (migration 0040_least_privilege_roles.sql creates the roles themselves, with no password until
# this is done). Used, together with POSTGRES_DB above, to build the two connection strings below
# — kept as separate values here so the two roles are never accidentally given the same password.
SEMPREC_DATA_DB_PASSWORD=
SEMPREC_SIDE_DB_PASSWORD=

# SEMPREC_API_DATABASE_URL: semprec-api's own connection string, authenticating as `semprec_data`
# — the one role allowed to write through the generic choke-point. Never reused by any other
# process. Built from SEMPREC_DATA_DB_PASSWORD above, e.g.:
# postgres://semprec_data:<SEMPREC_DATA_DB_PASSWORD>@127.0.0.1:5432/semprec
SEMPREC_API_DATABASE_URL=

# SEMPREC_SIDE_DATABASE_URL: shared by every `semprec_side`-role process (semprec-ai-gateway
# today; semprec-agents/semprec-mailsync@/semprec-transcribe once built, per
# docs/operations/database-roles.md) — none of them ever writes a choke-point table, so one
# read-only-on-choke-point, full-on-side-tables role covers all of them. Built from
# SEMPREC_SIDE_DB_PASSWORD above, e.g.:
# postgres://semprec_side:<SEMPREC_SIDE_DB_PASSWORD>@127.0.0.1:5432/semprec
SEMPREC_SIDE_DATABASE_URL=

# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD: deploy/docker-compose.yml's `minio` container root
# credentials — a distinct secret from every Postgres value above, never reused across services.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---- VAPID (issue #151, web push) ----

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT: generate the key pair with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a mailto: or https: URL identifying this
# deployment's operator, per the Web Push protocol.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- APNs (issue #151, iOS push) ----

# APNS_TEAM_ID / APNS_KEY_ID / APNS_TOPIC: from the Apple Developer account's APNs auth key and
# the app's bundle id. APNS_PRIVATE_KEY_PATH points at the `.p8` file distributed alongside this
# one — see the header comment above.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=/opt/semprec/shared/apns-key.p8
APNS_TOPIC=

# ---- Provider (semprec-ai-gateway, issue #215) ----

# AI_GATEWAY_INTERNAL_TOKEN: shared between semprec-api and semprec-ai-gateway — every process
# that calls POST /internal/complete must present this exact value as its Bearer token. Generate
# with: openssl rand -hex 32
AI_GATEWAY_INTERNAL_TOKEN=

# AI_GATEWAY_STRUCTURED_PROVIDER / AI_GATEWAY_STRUCTURED_MODEL: the provider+model
# POST /internal/complete uses. No default — startup fails without both.
AI_GATEWAY_STRUCTURED_PROVIDER=anthropic
AI_GATEWAY_STRUCTURED_MODEL=

# ANTHROPIC_API_KEY: required when AI_GATEWAY_STRUCTURED_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK / AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK: USD
# per million tokens for the configured model, read from configuration since rate cards change.
AI_GATEWAY_STRUCTURED_INPUT_PRICE_PER_MTOK=
AI_GATEWAY_STRUCTURED_OUTPUT_PRICE_PER_MTOK=

# ---- OAuth (issue #26 mail sync providers, not yet built) ----

# GMAIL_OAUTH_CLIENT_ID / GMAIL_OAUTH_CLIENT_SECRET: Google Cloud OAuth client for Gmail API mail
# sync (mailSyncJob.ts's "gmail_api" mode). Consumed by semprec-mailsync once built.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# MS_GRAPH_OAUTH_CLIENT_ID / MS_GRAPH_OAUTH_CLIENT_SECRET: Microsoft Entra app registration for
# Graph API mail sync (mailSyncJob.ts's "graph_api" mode). Consumed by semprec-mailsync once built.
MS_GRAPH_OAUTH_CLIENT_ID=
MS_GRAPH_OAUTH_CLIENT_SECRET=

# ---- restic (issue #177, encrypted off-site backup) ----

# RESTIC_REPOSITORY / RESTIC_PASSWORD: the off-site S3-compatible restic repository and its
# encryption password. RESTIC_PASSWORD is never the same value as CREDENTIALS_MASTER_KEY — a
# leaked backup password must not also unlock external_credentials, and vice versa.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# ---- healthchecks (issue #171, dead-man switch) ----

# SEMPREC_DOMAIN: the public Caddy domain, without a URL scheme. The dead-man timer probes
# https://$SEMPREC_DOMAIN/healthz before it sends the monitor success ping.
SEMPREC_DOMAIN=

# HEALTHCHECKS_PING_URL: pinged only after the five-minute dead-man timer's own public
# GET /healthz succeeds — this URL never substitutes for that check.
HEALTHCHECKS_PING_URL=
