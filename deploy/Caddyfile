# Issue #174: the single public entry point for the whole deployment — one domain, one proxy
# point, no subdomains. Automatic TLS (Let's Encrypt) and HTTP/2 are Caddy defaults for a site
# address that is a bare domain, so neither needs an explicit directive here.
#
# `semprec-api` is the only public-facing process; it must be configured (via
# /opt/semprec/shared/.env's PORT, see services/semprec-api/.env.example) to listen on the same
# port this reverse_proxy targets. It alone serves every public route behind this domain,
# including the `/api/sync` WebSocket upgrade and the Graph webhook — Caddy's reverse_proxy
# forwards WebSocket upgrades transparently, so no separate handling is needed for either.
{$SEMPREC_DOMAIN} {
	encode zstd gzip

	header {
		# No includeSubDomains/preload: this deployment intentionally keeps HSTS scoped to
		# exactly the one domain it terminates TLS for.
		Strict-Transport-Security "max-age=31536000"
	}

	# Two mutually exclusive request-body ceilings: everything except `POST /api/files` is
	# capped at the 16 MB default; only `POST /api/files` (issue #158's streamed upload route)
	# is allowed up to 2 GB.
	@files {
		method POST
		path /api/files
	}
	request_body @files {
		max_size 2GB
	}

	@notfiles {
		not {
			method POST
			path /api/files
		}
	}
	request_body @notfiles {
		max_size 16MB
	}

	reverse_proxy 127.0.0.1:8080

	log {
		output stderr
		format json
	}
}
